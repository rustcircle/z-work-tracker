{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "zWorkTracker",
  "mainBinaryName": "zWorkTracker",
  "version": "0.1.0",
  "identifier": "com.rustcircle.zworktracker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "zWorkTracker",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "capabilities": [
        "default"
      ],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app"
    ],
    "publisher": "Pedro Jorge",
    "copyright": "Copyright (c) 2026 Pedro Jorge",
    "category": "Productivity",
    "shortDescription": "Labor hours tracker",
    "longDescription": "Local-first tracker of labor hours by project and task, with timeline, analysis and spreadsheet exports.",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "crates/z-work-core/fonts/OFL.txt": "licenses/NotoSans-OFL.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "signCommand": "node ../scripts/windows-sign.mjs %1",
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "English": "windows/English.nsh"
        }
      }
    }
  }
}
