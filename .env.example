# Signing is opt-in. Leave everything blank to build UNSIGNED. Never commit real values.
# Keep real values in a local .env (git-ignored) or in GitHub Actions secrets.

# Route 1: Azure Artifact Signing (formerly Trusted Signing), primary route.
AZURE_SIGNING_ENDPOINT=
AZURE_SIGNING_ACCOUNT=
AZURE_SIGNING_PROFILE=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Route 2: your own code-signing certificate, which is the self-signed route in the README.
# On Windows, either a certificate in the store by thumbprint, or a PFX. From macOS, a PFX with osslsigncode.
# Keep the PFX outside this repository and any sync folder.
WINDOWS_CERT_THUMBPRINT=
WINDOWS_CERT_PFX_PATH=
WINDOWS_CERT_PASSWORD=
# Optional. RFC 3161 timestamp server; a default is used when blank.
WINDOWS_TIMESTAMP_URL=

# SignPath Foundation route, not in use: GitHub Actions only, set as repository settings, never here.
# Secret: SIGNPATH_API_TOKEN. Variables: SIGNING_ROUTE=signpath, SIGNPATH_ORGANIZATION_ID, SIGNPATH_CONNECTOR_URL.
