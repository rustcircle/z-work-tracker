{
  "name": "z-work-tracker",
  "private": true,
  "license": "MIT",
  "author": "Pedro Jorge <p@rustcircle.com>",
  "repository": "https://github.com/rustcircle/z-work-tracker",
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "e2e": "playwright test",
    "tauri": "tauri",
    "smoke:native": "node scripts/native-smoke.mjs",
    "gen:tz": "cargo run --manifest-path src-tauri/Cargo.toml -p z-work-core --example gen_tzdata -- src/generated/tzdata.json",
    "package:windows": "node scripts/package-windows.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.7.0",
    "@tauri-apps/api": "~2.12.4",
    "@tiptap/extension-task-item": "^3.32.1",
    "@tiptap/extension-task-list": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "~2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
